rules_version = '2';

// Accés obert: no hi ha login (decisió explícita). Qualsevol persona amb la
// URL del projecte podria llegir/escriure les dades. Si més endavant es vol
// protegir, es pot canviar a `allow read, write: if request.auth != null;`
// i afegir Firebase Auth al frontend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      allow read, write: if true;
    }
  }
}
